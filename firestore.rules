rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'muhammedomor.dev@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true) ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidBadgeType(badge) {
      return badge in ['none', 'blue', 'red_admin'];
    }

    function isValidAccountStatus(status) {
      return status in ['active', 'suspended', 'banned', 'deactivated'];
    }

    function isValidDriveLink(url) {
      return url is string &&
             url.size() <= 500 &&
             (url.size() == 0 || url.matches('^https://(drive|docs)\\.google\\.com/.*$'));
    }

    function isValidCommunityUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'photoUrl', 'badgeType', 'restricted', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'bio', 'badgeType', 'accountStatus', 'restricted', 'restrictionReason', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.photoUrl is string && data.photoUrl.size() <= 500 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             isValidBadgeType(data.badgeType) &&
             (!('accountStatus' in data) || isValidAccountStatus(data.accountStatus)) &&
             data.restricted is bool &&
             (!('accountStatus' in data) || ((data.accountStatus == 'active' && data.restricted == false) || (data.accountStatus != 'active' && data.restricted == true))) &&
             (!('restrictionReason' in data) || (data.restrictionReason is string && data.restrictionReason.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function userProfileExists(uid) {
      return exists(/databases/$(database)/documents/community_users/$(uid));
    }

    function isAuthorNotRestricted(uid) {
      let profile = get(/databases/$(database)/documents/community_users/$(uid)).data;
      return userProfileExists(uid) &&
             profile.restricted == false &&
             (!('accountStatus' in profile) || profile.accountStatus == 'active');
    }

    function getAuthorBadge(uid) {
      return get(/databases/$(database)/documents/community_users/$(uid)).data.badgeType;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'authorPhotoUrl', 'authorBadge', 'content', 'visibility', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['authorUid', 'authorName', 'authorPhotoUrl', 'authorBadge', 'content', 'driveLink', 'bookTitle', 'likeCount', 'visibility', 'moderationNote', 'createdAt', 'updatedAt']) &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500 &&
             isValidBadgeType(data.authorBadge) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             (!('driveLink' in data) || isValidDriveLink(data.driveLink)) &&
             (!('bookTitle' in data) || (data.bookTitle is string && data.bookTitle.size() <= 120)) &&
             (!('likeCount' in data) || (data.likeCount is int && data.likeCount >= 0)) &&
             data.visibility in ['visible', 'hidden', 'removed'] &&
             (!('moderationNote' in data) || (data.moderationNote is string && data.moderationNote.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPostReaction(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'createdAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidBlockedUser(data, expectedBlockedUid) {
      return data.keys().hasAll(['blockedUid', 'displayName', 'createdAt']) &&
             data.keys().hasOnly(['blockedUid', 'displayName', 'photoUrl', 'createdAt']) &&
             data.blockedUid == expectedBlockedUid &&
             isValidId(data.blockedUid) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCommunityComment(data, expectedPostId) {
      return data.keys().hasAll(['postId', 'authorUid', 'authorName', 'authorPhotoUrl', 'authorBadge', 'content', 'visibility', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['postId', 'authorUid', 'authorName', 'authorPhotoUrl', 'authorBadge', 'parentCommentId', 'replyToAuthorName', 'content', 'visibility', 'moderationNote', 'createdAt', 'updatedAt']) &&
             data.postId == expectedPostId &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500 &&
             isValidBadgeType(data.authorBadge) &&
             (!('parentCommentId' in data) || (data.parentCommentId is string && data.parentCommentId.size() <= 128)) &&
             (!('replyToAuthorName' in data) || (data.replyToAuthorName is string && data.replyToAuthorName.size() <= 60)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
             data.visibility in ['visible', 'hidden', 'removed'] &&
             (!('moderationNote' in data) || (data.moderationNote is string && data.moderationNote.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCommunityReport(data) {
      return data.keys().hasAll(['reporterUid', 'targetType', 'targetId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'parentPostId', 'targetSummary', 'reason', 'details', 'status', 'reviewedBy', 'moderationAction', 'createdAt', 'updatedAt']) &&
             data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 &&
             data.targetType in ['post', 'comment', 'profile'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             (!('parentPostId' in data) || (data.parentPostId is string && data.parentPostId.size() <= 128)) &&
             (!('targetSummary' in data) || (data.targetSummary is string && data.targetSummary.size() <= 200)) &&
             data.reason in ['harassment', 'insults', 'spam', 'malicious_link', 'impersonation', 'harmful_content', 'unlawful_content', 'other'] &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
             data.status in ['pending', 'reviewed', 'action_taken', 'dismissed'] &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!('moderationAction' in data) || (data.moderationAction is string && data.moderationAction.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidModerationAuditLog(data) {
      return data.keys().hasAll(['adminUid', 'action', 'targetType', 'targetId', 'createdAt']) &&
             data.keys().hasOnly(['adminUid', 'action', 'targetType', 'targetId', 'note', 'createdAt']) &&
             data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
             data.targetType in ['post', 'comment', 'profile', 'report'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /community_users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidCommunityUser(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().uid == request.auth.uid &&
                       incoming().restricted == false &&
                       (!('accountStatus' in incoming()) || incoming().accountStatus == 'active') &&
                       !('restrictionReason' in incoming()) &&
                       (
                         incoming().badgeType == 'none' ||
                         (isBootstrappedAdmin() && incoming().badgeType == 'red_admin')
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidCommunityUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           request.auth.uid == userId &&
                           incoming().badgeType == existing().badgeType &&
                           incoming().restricted == existing().restricted &&
                           (!('accountStatus' in incoming()) ? !('accountStatus' in existing()) : incoming().accountStatus == existing().accountStatus) &&
                           (!('restrictionReason' in incoming()) ? !('restrictionReason' in existing()) : incoming().restrictionReason == existing().restrictionReason) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'bio', 'updatedAt'])
                         ) ||
                         (
                           isAdmin() &&
                           // Protected official admin cannot lose red_admin or be restricted/suspended/banned/deactivated
                           !(existing().badgeType == 'red_admin' && (
                             incoming().badgeType != 'red_admin' ||
                             incoming().restricted == true ||
                             ('accountStatus' in incoming() && incoming().accountStatus != 'active')
                           )) &&
                           // Only bootstrapped admin account receives red_admin; admins grant/revoke 'blue' or 'none' for others
                           (incoming().badgeType != 'red_admin' || existing().badgeType == 'red_admin') &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['badgeType', 'accountStatus', 'restricted', 'restrictionReason', 'updatedAt'])
                         )
                       );

      allow delete: if false;

      match /blocked_users/{blockedUid} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(blockedUid) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(blockedUid) &&
                         request.auth.uid == userId &&
                         blockedUid != request.auth.uid &&
                         isValidBlockedUser(incoming(), blockedUid);
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(blockedUid) && request.auth.uid == userId;
      }
    }

    match /community_posts/{postId} {
      allow get: if isSignedIn() &&
                    isValidId(postId) &&
                    (existing().visibility == 'visible' || existing().authorUid == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
                     (existing().visibility == 'visible' || existing().authorUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidCommunityPost(incoming()) &&
                       incoming().authorUid == request.auth.uid &&
                       incoming().visibility == 'visible' &&
                       (!('likeCount' in incoming()) || incoming().likeCount == 0) &&
                       !('moderationNote' in incoming()) &&
                       isAuthorNotRestricted(request.auth.uid) &&
                       incoming().authorBadge == getAuthorBadge(request.auth.uid);

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidCommunityPost(incoming()) &&
                       incoming().authorUid == existing().authorUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           existing().authorUid == request.auth.uid &&
                           existing().visibility == 'visible' &&
                           isAuthorNotRestricted(request.auth.uid) &&
                           incoming().authorBadge == existing().authorBadge &&
                           incoming().visibility == existing().visibility &&
                           (!('likeCount' in incoming()) ? !('likeCount' in existing()) : incoming().likeCount == existing().likeCount) &&
                           (!('moderationNote' in incoming()) ? !('moderationNote' in existing()) : incoming().moderationNote == existing().moderationNote) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['content', 'driveLink', 'bookTitle', 'updatedAt'])
                         ) ||
                         (
                           isAdmin() &&
                           (!('likeCount' in incoming()) ? !('likeCount' in existing()) : incoming().likeCount == existing().likeCount) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'moderationNote', 'updatedAt'])
                         ) ||
                         (
                           existing().visibility == 'visible' &&
                           isAuthorNotRestricted(request.auth.uid) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['likeCount']) &&
                           (
                             (
                               !exists(/databases/$(database)/documents/community_posts/$(postId)/reactions/$(request.auth.uid)) &&
                               existsAfter(/databases/$(database)/documents/community_posts/$(postId)/reactions/$(request.auth.uid)) &&
                               (
                                 (!('likeCount' in existing()) && incoming().likeCount == 1) ||
                                 ('likeCount' in existing() && incoming().likeCount == existing().likeCount + 1)
                               )
                             ) ||
                             (
                               exists(/databases/$(database)/documents/community_posts/$(postId)/reactions/$(request.auth.uid)) &&
                               !existsAfter(/databases/$(database)/documents/community_posts/$(postId)/reactions/$(request.auth.uid)) &&
                               'likeCount' in existing() &&
                               existing().likeCount >= 1 &&
                               incoming().likeCount == existing().likeCount - 1
                             )
                           )
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(postId) &&
                       (existing().authorUid == request.auth.uid || isAdmin());

      match /reactions/{reactionUid} {
        allow get: if isSignedIn() &&
                      isValidId(postId) &&
                      isValidId(reactionUid) &&
                      (request.auth.uid == reactionUid || isAdmin());
        allow list: if isAdmin();
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(reactionUid) &&
                         request.auth.uid == reactionUid &&
                         isValidPostReaction(incoming()) &&
                         incoming().uid == request.auth.uid &&
                         exists(/databases/$(database)/documents/community_posts/$(postId)) &&
                         get(/databases/$(database)/documents/community_posts/$(postId)).data.visibility == 'visible' &&
                         isAuthorNotRestricted(request.auth.uid) &&
                         (
                           ('likeCount' in get(/databases/$(database)/documents/community_posts/$(postId)).data &&
                            getAfter(/databases/$(database)/documents/community_posts/$(postId)).data.likeCount == get(/databases/$(database)/documents/community_posts/$(postId)).data.likeCount + 1) ||
                           (!('likeCount' in get(/databases/$(database)/documents/community_posts/$(postId)).data) &&
                            getAfter(/databases/$(database)/documents/community_posts/$(postId)).data.likeCount == 1)
                         );
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(reactionUid) &&
                         (
                           isAdmin() ||
                           (
                             request.auth.uid == reactionUid &&
                             exists(/databases/$(database)/documents/community_posts/$(postId)) &&
                             'likeCount' in get(/databases/$(database)/documents/community_posts/$(postId)).data &&
                             get(/databases/$(database)/documents/community_posts/$(postId)).data.likeCount >= 1 &&
                             getAfter(/databases/$(database)/documents/community_posts/$(postId)).data.likeCount == get(/databases/$(database)/documents/community_posts/$(postId)).data.likeCount - 1
                           )
                         );
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() &&
                      isValidId(postId) &&
                      isValidId(commentId) &&
                      (existing().visibility == 'visible' || existing().authorUid == request.auth.uid || isAdmin());

        allow list: if isSignedIn() &&
                       isValidId(postId) &&
                       (existing().visibility == 'visible' || existing().authorUid == request.auth.uid || isAdmin());

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         exists(/databases/$(database)/documents/community_posts/$(postId)) &&
                         get(/databases/$(database)/documents/community_posts/$(postId)).data.visibility == 'visible' &&
                         isValidCommunityComment(incoming(), postId) &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().visibility == 'visible' &&
                         !('moderationNote' in incoming()) &&
                         isAuthorNotRestricted(request.auth.uid) &&
                         incoming().authorBadge == getAuthorBadge(request.auth.uid) &&
                         (
                           !('parentCommentId' in incoming()) ||
                           incoming().parentCommentId.size() == 0 ||
                           (
                             isValidId(incoming().parentCommentId) &&
                             exists(/databases/$(database)/documents/community_posts/$(postId)/comments/$(incoming().parentCommentId))
                           )
                         );

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidCommunityComment(incoming(), postId) &&
                         incoming().postId == existing().postId &&
                         incoming().authorUid == existing().authorUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (
                             existing().authorUid == request.auth.uid &&
                             existing().visibility == 'visible' &&
                             isAuthorNotRestricted(request.auth.uid) &&
                             incoming().authorBadge == existing().authorBadge &&
                             incoming().visibility == existing().visibility &&
                             (!('parentCommentId' in incoming()) ? !('parentCommentId' in existing()) : incoming().parentCommentId == existing().parentCommentId) &&
                             (!('moderationNote' in incoming()) ? !('moderationNote' in existing()) : incoming().moderationNote == existing().moderationNote) &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])
                           ) ||
                           (
                             isAdmin() &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'moderationNote', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (existing().authorUid == request.auth.uid || isAdmin());
      }
    }

    match /community_reports/{reportId} {
      allow get: if isSignedIn() &&
                    isValidId(reportId) &&
                    (existing().reporterUid == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
                     (existing().reporterUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidCommunityReport(incoming()) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().status == 'pending' &&
                       !('reviewedBy' in incoming()) &&
                       !('moderationAction' in incoming());

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       isAdmin() &&
                       isValidCommunityReport(incoming()) &&
                       incoming().reporterUid == existing().reporterUid &&
                       incoming().targetType == existing().targetType &&
                       incoming().targetId == existing().targetId &&
                       (!('parentPostId' in incoming()) ? !('parentPostId' in existing()) : incoming().parentPostId == existing().parentPostId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'moderationAction', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /moderation_audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       isValidModerationAuditLog(incoming()) &&
                       incoming().adminUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
