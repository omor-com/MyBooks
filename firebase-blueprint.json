{
  "entities": {
    "CommunityUser": {
      "title": "CommunityUser",
      "description": "Public Community user profile without private PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "displayName": { "type": "string", "description": "Display name (1..60 chars)." },
        "photoUrl": { "type": "string", "description": "Profile avatar URL." },
        "bio": { "type": "string", "description": "Optional short bio (0..300 chars)." },
        "badgeType": {
          "type": "string",
          "enum": ["none", "blue", "red_admin"],
          "description": "Server/admin-controlled verification badge."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended", "banned", "deactivated"],
          "description": "Account standing managed by official administration."
        },
        "restricted": { "type": "boolean", "description": "Whether user posting/commenting is restricted by admin." },
        "restrictionReason": { "type": "string", "description": "Optional admin moderation notice or reason." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["uid", "displayName", "photoUrl", "badgeType", "restricted", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Server-provisioned administrator marker document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Text-and-emoji Community discussion post with optional Google Drive book button.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "description": "Firebase Auth UID of post author." },
        "authorName": { "type": "string", "description": "Author display name." },
        "authorPhotoUrl": { "type": "string", "description": "Author avatar URL." },
        "authorBadge": {
          "type": "string",
          "enum": ["none", "blue", "red_admin"],
          "description": "Verified badge matching author profile at creation."
        },
        "content": { "type": "string", "description": "Post text and emojis (1..2000 chars)." },
        "driveLink": { "type": "string", "description": "Optional validated Google Drive/Docs HTTPS URL." },
        "bookTitle": { "type": "string", "description": "Book title shown on the Google Drive button when driveLink is provided (0..120 chars)." },
        "likeCount": { "type": "integer", "description": "Non-negative atomic like counter updated via reactions transactions." },
        "visibility": {
          "type": "string",
          "enum": ["visible", "hidden", "removed"],
          "description": "Moderation visibility state."
        },
        "moderationNote": { "type": "string", "description": "Optional admin moderation note." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["authorUid", "authorName", "authorPhotoUrl", "authorBadge", "content", "visibility", "createdAt", "updatedAt"]
    },
    "PostReaction": {
      "title": "PostReaction",
      "description": "Per-user like marker stored atomically alongside CommunityPost.likeCount.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of reacting user." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." }
      },
      "required": ["uid", "createdAt"]
    },
    "BlockedUserEntry": {
      "title": "BlockedUserEntry",
      "description": "Owner-private blocked user entry stored under community_users/{userId}/blocked_users/{blockedUid}.",
      "type": "object",
      "properties": {
        "blockedUid": { "type": "string", "description": "UID of the blocked Community user." },
        "displayName": { "type": "string", "description": "Snapshot display name of blocked user." },
        "photoUrl": { "type": "string", "description": "Snapshot avatar URL of blocked user." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." }
      },
      "required": ["blockedUid", "displayName", "createdAt"]
    },
    "CommunityComment": {
      "title": "CommunityComment",
      "description": "Comment or threaded reply under a Community post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "Parent post document ID." },
        "authorUid": { "type": "string", "description": "Firebase Auth UID of comment author." },
        "authorName": { "type": "string", "description": "Author display name." },
        "authorPhotoUrl": { "type": "string", "description": "Author avatar URL." },
        "authorBadge": {
          "type": "string",
          "enum": ["none", "blue", "red_admin"],
          "description": "Verified badge matching author profile at creation."
        },
        "parentCommentId": { "type": "string", "description": "Optional parent comment ID when this item is a reply." },
        "replyToAuthorName": { "type": "string", "description": "Optional display name of the comment author being replied to." },
        "content": { "type": "string", "description": "Comment text and emojis (1..1000 chars)." },
        "visibility": {
          "type": "string",
          "enum": ["visible", "hidden", "removed"],
          "description": "Moderation visibility state."
        },
        "moderationNote": { "type": "string", "description": "Optional admin moderation note." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorUid", "authorName", "authorPhotoUrl", "authorBadge", "content", "visibility", "createdAt", "updatedAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "User-submitted report against a post, comment, or profile.",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string", "description": "UID of reporting user." },
        "targetType": { "type": "string", "enum": ["post", "comment", "profile"] },
        "targetId": { "type": "string", "description": "Reported post ID, comment ID, or user UID." },
        "parentPostId": { "type": "string", "description": "Optional parent post ID when targetType is comment." },
        "targetSummary": { "type": "string", "description": "Optional summary snippet." },
        "reason": {
          "type": "string",
          "enum": ["harassment", "insults", "spam", "malicious_link", "impersonation", "harmful_content", "unlawful_content", "other"]
        },
        "details": { "type": "string", "description": "Optional explanation (0..500 chars)." },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "action_taken", "dismissed"]
        },
        "reviewedBy": { "type": "string", "description": "Admin UID that reviewed the report." },
        "moderationAction": { "type": "string", "description": "Action taken by admin." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUid", "targetType", "targetId", "reason", "status", "createdAt", "updatedAt"]
    },
    "ModerationAuditLog": {
      "title": "ModerationAuditLog",
      "description": "Append-only audit log of administrator moderation actions.",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "comment", "profile", "report"] },
        "targetId": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminUid", "action", "targetType", "targetId", "createdAt"]
    }
  },
  "firestore": {
    "/community_users/{userId}": {
      "schema": { "$ref": "#/entities/CommunityUser" },
      "description": "Community user profiles and admin-controlled badge/account status states."
    },
    "/community_users/{userId}/blocked_users/{blockedUid}": {
      "schema": { "$ref": "#/entities/BlockedUserEntry" },
      "description": "Owner-private blocked Community member list."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Server-provisioned administrator markers."
    },
    "/community_posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Community book discussion posts."
    },
    "/community_posts/{postId}/reactions/{reactionUid}": {
      "schema": { "$ref": "#/entities/PostReaction" },
      "description": "Per-user like markers paired atomically with CommunityPost.likeCount."
    },
    "/community_posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommunityComment" },
      "description": "Comments and threaded replies scoped under a Community post."
    },
    "/community_reports/{reportId}": {
      "schema": { "$ref": "#/entities/CommunityReport" },
      "description": "Moderation reports submitted by signed-in users."
    },
    "/moderation_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/ModerationAuditLog" },
      "description": "Append-only moderation audit history readable and writable only by admins."
    }
  }
}
